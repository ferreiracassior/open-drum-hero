{
  "name": "drumhero-desktop",
  "productName": "OpenDrumHero",
  "version": "1.0.2",
  "description": "OpenDrumHero for Windows: the same app as the phone, packaged with Electron.",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.opendrumhero.app",
    "productName": "OpenDrumHero",
    "files": ["main.cjs", "preload.cjs", "app/**/*"],
    "directories": { "output": "../release" },
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "icon.ico",
      "artifactName": "OpenDrumHero-${version}.exe"
    },
    "portable": { "unicode": true }
  }
}
